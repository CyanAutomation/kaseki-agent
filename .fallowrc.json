{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    ".pi-extensions.js",
    "src/cli.ts",
    "src/kaseki-cli.ts",
    "src/kaseki-api-service.ts",
    "src/get-caveman-prompt.ts",
    "src/kaseki-api/index.ts",
    "src/jev-workflow-evaluator.ts",
    "scripts/context-handoff.js",
    "scripts/write-run-metadata.mjs",
    "scripts/render-caveman-impact-report.mjs",
    "scripts/**/*.ts"
  ],
  "ignorePatterns": [
    "**/*.test.d.ts",
    "**/*.test.d.ts.map",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.type-test.ts",
    "src/**/*-test-fixtures.ts",
    "src/test-utils.ts",
    "src/test-utils/**",
    "test/**",
    "tests/**",
    "src/__test-utils/**",
    "src/**/*.test.js.map",
    "scripts/score-tests.ts",
    ".github/**"
  ],
  "duplicates": {
    "minOccurrences": 3
  },
  "rules": {
    "unused-dependencies": "warn"
  },
  "ignoreDependencies": [
    "@earendil-works/pi-coding-agent"
  ],
  "usedClassMembers": [
    "execute",
    "getRunStatusUrl",
    "createRun",
    "listRuns",
    "getRunStatus",
    "getRunAnalysis",
    "getRunLog",
    "cancelRun",
    {
      "extends": "BaseCommand",
      "members": ["execute"]
    },
    {
      "extends": "LocalKasekiApiClient",
      "members": [
        "getRunStatusUrl",
        "createRun",
        "listRuns",
        "getRunStatus",
        "getRunAnalysis",
        "getRunLog",
        "cancelRun"
      ]
    }
  ],
  "ignoreExports": [
    {
      "file": "src/event-aggregator.ts",
      "exports": ["*"]
    },
    {
      "file": "src/execution-time-aggregator.ts",
      "exports": ["*"]
    },
    {
      "file": "src/token-usage-aggregator.ts",
      "exports": ["*"]
    },
    {
      "file": "src/tool-reliability-aggregator.ts",
      "exports": ["*"]
    },
    {
      "file": "src/lib/subprocess-helpers.ts",
      "exports": ["*"]
    },
    {
      "file": "src/utils/file-helpers.ts",
      "exports": ["*"]
    }
  ]
}
