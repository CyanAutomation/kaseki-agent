{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    ".pi-extensions.js",
    "src/cli.ts",
    "src/kaseki-api-service.ts",
    "src/get-caveman-prompt.ts",
    "src/kaseki-api/index.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.type-test.ts",
    "test/**/*.test.ts",
    "tests/**/*.test.ts",
    "scripts/**/*.ts",
    "scripts/**/*.test.ts"
  ],
  "ignorePatterns": [
    "**/*.test.d.ts",
    "**/*.test.d.ts.map",
    "scripts/score-tests.ts",
    ".github/**"
  ],
  "duplicates": {
    "minOccurrences": 3
  },
  "rules": {
    "unused-dependencies": "warn"
  },
  "ignoreDependencies": [
    "@earendil-works/pi-coding-agent",
    "tree-sitter-cli",
    "tree-sitter-go",
    "tree-sitter-typescript",
    "tree-sitter"
  ],
  "usedClassMembers": [
    "execute",
    "getRunStatusUrl",
    "createRun",
    "listRuns",
    "getRunStatus",
    "getRunAnalysis",
    "getRunLog",
    "cancelRun",
    {
      "extends": "BaseCommand",
      "members": ["execute"]
    },
    {
      "extends": "LocalKasekiApiClient",
      "members": [
        "getRunStatusUrl",
        "createRun",
        "listRuns",
        "getRunStatus",
        "getRunAnalysis",
        "getRunLog",
        "cancelRun"
      ]
    }
  ],
  "ignoreExports": [
    {
      "file": "src/event-aggregator.ts",
      "exports": ["*"]
    },
    {
      "file": "src/execution-time-aggregator.ts",
      "exports": ["*"]
    },
    {
      "file": "src/token-usage-aggregator.ts",
      "exports": ["*"]
    },
    {
      "file": "src/tool-reliability-aggregator.ts",
      "exports": ["*"]
    },
    {
      "file": "src/lib/subprocess-helpers.ts",
      "exports": ["*"]
    },
    {
      "file": "src/utils/file-helpers.ts",
      "exports": ["*"]
    }
  ]
}
